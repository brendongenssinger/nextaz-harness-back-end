# Modelo de preparacao. NAO esta pronto para deploy: preencher valores e definir a vertical.
# Copiar para .env.production (ignorado no Git). Nunca colar secrets em chat/logs.
# Formato raw do Docker Compose >= 2.30: KEY=valor, sem aspas externas ou comentarios inline.
DOTNET_ENVIRONMENT=Production
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_HTTP_PORTS=8080
AllowedHosts=CHANGE_ME_HOST_HARNESS;localhost;127.0.0.1

# Issuer publico HTTPS do NextAZ Auth; nao usar o issuer local de desenvolvimento.
Authentication__Authority=https://CHANGE_ME_AUTH_HOST
Authentication__Audience=nextaz-harness-api

# Banco/usuario exclusivos do Harness. Pool e por processo; dimensionar todas as replicas.
# Inicio conservador: maximo 5 conexoes por processo, nao 5 para toda a plataforma.
ConnectionStrings__Harness=Host=CHANGE_ME_DB_HOST;Port=5432;Database=CHANGE_ME_DB_NAME;Username=CHANGE_ME_DB_USER;Password=CHANGE_ME_DB_PASSWORD;SSL Mode=VerifyFull;Pooling=true;Minimum Pool Size=0;Maximum Pool Size=5;Connection Idle Lifetime=60;Timeout=15;Command Timeout=30;Include Error Detail=false
Harness__Persistence__Provider=PostgreSql
Harness__Simulation__Enabled=false

# Habilita o adapter; conexao, token e modelo sao cadastrados por tenant.
Harness__Providers__OpenAI__Enabled=true
Harness__Providers__OpenAI__Endpoint=https://api.openai.com/v1/
Harness__Providers__OpenAI__ApiKey=
# Fallback local/volatil apenas. Em PostgreSQL, o modelId vem da rota persistida do agente.
Harness__Providers__OpenAI__Model=
Harness__Providers__OpenAI__AllowedMediaHosts__0=nextazstorage.blob.core.windows.net

# Classificador privado de recibos. O token deve vir do Azure Key Vault/secret store,
# nunca deste arquivo versionado. ReceiptLabels deve usar o id2label real do config.json do modelo.
Harness__Providers__HuggingFace__Enabled=false
Harness__Providers__HuggingFace__Endpoint=
Harness__Providers__HuggingFace__ApiKey=
Harness__Providers__HuggingFace__Model=brendonmascarenhas/train-identify-recibos
Harness__Providers__HuggingFace__ReceiptLabels__0=recibo
Harness__Providers__HuggingFace__MinimumScore=0.90
Harness__Providers__HuggingFace__AllowedMediaHosts__0=nextazstorage.blob.core.windows.net
Harness__Providers__HuggingFace__MaximumMediaBytes=10485760
Harness__Providers__HuggingFace__Pricing__EstimatedCostPerRequest=
Harness__Receipts__Enabled=false
# O provider/modelo de cada agente e tenant e configurado no banco pelo painel/API administrativa.
Harness__ProviderEncryption__KeyVaultKeyId=https://CHANGE_ME_KEY_VAULT.vault.azure.net/keys/nextaz-harness-provider-kek/CHANGE_ME_KEY_VERSION
# Se o host nao possui identidade gerenciada/Workload Identity, o DefaultAzureCredential
# tambem reconhece AZURE_TENANT_ID, AZURE_CLIENT_ID e AZURE_CLIENT_SECRET no arquivo privado.
# Opcional: permite um modelo multimodal diferente do modelo geral do Harness.
Harness__Receipts__Instructions=
Harness__Receipts__TenantIds__0=CHANGE_ME_TENANT_GUID
Authentication__ReceiptClassifierClientIds__0=nextaz-funcionario-digital-harness

# A integracao abaixo so e obrigatoria quando o agente da Imobiliaria estiver habilitado.
# Mantidos false para nao ativar um produto sem decisao explicita.
Harness__Imobiliaria__Enabled=false
Harness__Imobiliaria__TenantIds__0=CHANGE_ME_TENANT_GUID
Harness__Imobiliaria__Channels__0=web
Harness__Imobiliaria__Channels__1=api
Harness__Imobiliaria__Channels__2=whatsapp
Harness__Imobiliaria__Instructions=
Harness__Imobiliaria__Integration__Enabled=false
Harness__Imobiliaria__Integration__ApiBaseUrl=https://CHANGE_ME_IMOBILIARIA_HOST/
Harness__Imobiliaria__Integration__TokenEndpoint=https://CHANGE_ME_AUTH_HOST/connect/token
Harness__Imobiliaria__Integration__ClientId=nextaz-harness
Harness__Imobiliaria__Integration__ClientSecret=CHANGE_ME_HARNESS_TO_IMOBILIARIA_SECRET
Harness__Imobiliaria__Integration__Scope=imobiliaria.tools

# Cartorio e employee drafts nao sao ativados por este modelo.
Harness__Cartorio__Enabled=false
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning
